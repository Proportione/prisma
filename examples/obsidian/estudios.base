filters:
  and:
    - file.inFolder("estudios")
views:
  - type: table
    name: Todos
    order:
      - file.name
      - mmat_nivel
      - mmat_total
  - type: table
    name: MMAT High
    filters:
      and:
        - 'mmat_nivel == "High"'
    order:
      - file.name
      - mmat_total
  - type: table
    name: MMAT Medium
    filters:
      and:
        - 'mmat_nivel == "Medium"'
    order:
      - file.name
      - mmat_total
  - type: table
    name: MMAT Low
    filters:
      and:
        - 'mmat_nivel == "Low"'
    order:
      - file.name
      - mmat_total
